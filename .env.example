# Backend: Supabase Auth validates Google sessions and provides hosted Postgres.
SUPABASE_URL=https://your-project-ref.supabase.co
DB_DSN=postgresql://postgres.your-project-ref:YOUR_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:6543/postgres?sslmode=require

# LLM keys. Groq is the recommended fast development option for this project.
GROQ_API_KEY=
GEMINI_API_KEY=

# Optional local cache. Leave these as-is for local Docker development.
REDIS_HOST=localhost
REDIS_PORT=6379
